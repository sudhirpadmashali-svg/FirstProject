    <section id="jurisdictions-updated">
      <title>Jurisdictions Updated</title>
      <p><b>Overview:</b> The following jurisdictions' VAT content was refreshed in this release.
        Effective dates reflect the latest available content synchronization.</p>
      <table frame="all" id="juris-table">
        <title>Jurisdictions and effective dates</title>
        <tgroup cols="3">
          <colspec colname="c1" colwidth="1*"/>
          <colspec colname="c2" colwidth="2*"/>
