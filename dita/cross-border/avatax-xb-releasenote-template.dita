<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<!--
  AvaTax Cross-Border Release Note - DITA TEMPLATE
  Structural snippet mirroring CrossBorder_ReleaseNote_Template_forAutomation.docx.
  Placeholder provenance:
    [SYSTEM]        = populated by the automation service / Jira metadata
    [LLM-GENERATED] = drafted by the language model from source content
    [AUTHOR]        = supplied/curated by a human author when applicable
-->
<reference id="avatax_xb_rn_template">
  <title>Avalara AvaTax Cross-Border Release Notes</title>
  <shortdesc>This is a summary of system updates. It includes de minimis rules, HS taxonomy
    changes, customs valuation approaches, and cross-border content updates.</shortdesc>
  <prolog>
    <!-- [INTERNAL] Document Metadata Block - automation anchor, do not publish -->
    <metadata>
      <othermeta name="template-version" content="2.0"/>
      <othermeta name="template-type" content="Custom - Cross-Border"/>
      <othermeta name="product-area" content="[Jira Product Area value]"/><!-- [SYSTEM] -->
      <othermeta name="fix-version" content="[Jira Fix Version value]"/><!-- [SYSTEM] -->
      <othermeta name="content-sync-date" content="[latest content synchronization date]"/><!-- [SYSTEM] -->
      <othermeta name="content-library" content="[from Documentation Mapping Repository]"/><!-- [SYSTEM] -->
      <othermeta name="documentation-branch" content="[e.g., release-26.6]"/><!-- [SYSTEM] -->
      <othermeta name="dita-map-id" content="AVATAX_XB_RN_MAP"/><!-- [SYSTEM] -->
      <othermeta name="release-notes-required" content="[Yes | No]"/><!-- [SYSTEM] -->
      <othermeta name="approval-status" content="[Draft | In Review | Approved | Published]"/><!-- [SYSTEM] -->
      <othermeta name="publication-status" content="[Unpublished | Scheduled | Published]"/><!-- [SYSTEM] -->
      <othermeta name="validation-result" content="[Pass | Fail | Pending]"/><!-- [SYSTEM] -->
      <othermeta name="generation-timestamp" content="[auto-populated by automation service]"/><!-- [SYSTEM] -->
      <prodinfo>
        <prodname>[e.g., AvaTax Cross-Border]</prodname><!-- [SYSTEM] -->
        <vrmlist>
          <vrm version="[e.g., 26.6.1.0]"/><!-- [SYSTEM] Release Version -->
        </vrmlist>
      </prodinfo>
    </metadata>
    <critdates>
      <created date="[YYYY-MM-DD]"/><!-- [SYSTEM] Release Date -->
      <revised modified="[auto-populated by automation service]"/><!-- [SYSTEM] Last Updated -->
    </critdates>
  </prolog>
  <refbody>
    <section id="release" outputclass="release-heading">
      <title>Release Note [Version] ([Month Year])</title>
    </section>

    <section id="systems-updated">
      <title>Systems Updated</title>
      <p><b>Overview:</b> [Summarize which content systems were refreshed in this release.
        Effective dates reflect the latest available content synchronization. — LLM-GENERATED]</p>
      <table frame="all" id="systems-table">
        <title>Systems and effective dates</title>
        <tgroup cols="3">
          <colspec colname="c1" colwidth="1*"/>
          <colspec colname="c2" colwidth="2*"/>
          <colspec colname="c3" colwidth="1*"/>
          <thead>
            <row>
              <entry>System Code</entry>
              <entry>System Name / Region</entry>
              <entry>Effective Date</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>[e.g., HTS A]</entry>
              <entry>[e.g., United States]</entry>
              <entry>[DD Mon YYYY]</entry>
            </row>
            <row>
              <entry>[System code]</entry>
              <entry>[System name / region]</entry>
              <entry>[DD Mon YYYY]</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

    <section id="de-minimis">
      <title>Changes to De Minimis Rules</title>
      <p><b>What changed:</b> [List each jurisdiction whose de minimis threshold changed, with the
        new value and, where relevant, the prior value. If none, write: "No changes to de minimis
        rules in this release." — LLM-GENERATED]</p>
      <dl outputclass="change-card">
        <dlentry>
          <dt>Jurisdiction</dt>
          <dd>[Jurisdiction]</dd>
        </dlentry>
        <dlentry>
          <dt>Update</dt>
          <dd>[Change detail, e.g., updated to [new threshold] (from [prior threshold])]</dd>
        </dlentry>
        <dlentry>
          <dt>Effective From</dt>
          <dd>[DD Mon YYYY]</dd>
        </dlentry>
        <dlentry>
          <dt>Impact</dt>
          <dd>[Narrative describing how the change affects shipments. — LLM-GENERATED]</dd>
        </dlentry>
      </dl>
    </section>

    <section id="hs-taxonomy">
      <title>Changes to HS Taxonomy</title>
      <p><b>What changed:</b> [Summarize chapter additions and deletions by system. List each
        affected system as a sub-heading with its added and deleted HS chapters. If none, write:
        "No HS taxonomy changes in this release." — LLM-GENERATED]</p>
      <!-- Repeat the block below for each affected system -->
      <p outputclass="system-heading"><b>[System Code] ([Region])</b></p>
      <dl outputclass="change-card">
        <dlentry>
          <dt>Additions</dt>
          <dd>[HS chapters added, e.g., 07 (Edible vegetables); 08 (Edible fruit and nuts)]</dd>
        </dlentry>
        <dlentry>
          <dt>Deletions</dt>
          <dd>[HS chapters deleted, or "none"]</dd>
        </dlentry>
      </dl>
    </section>

    <section id="customs-valuation">
      <title>Changes to Customs Valuation Approaches</title>
      <p><b>What changed:</b> [Describe any changes to customs valuation methods or approaches.
        If none, write: "No changes." — LLM-GENERATED]</p>
    </section>

    <section id="updated-content">
      <title>Updated Cross-Border Content</title>
      <p><b>Overview:</b> [Summarize MFN and preferential rate updates. Where volume is high,
        condense the full list of FTAs and note that it has been condensed. Group by system.
        — LLM-GENERATED]</p>
      <!-- Repeat the block below for each affected system -->
      <p outputclass="system-heading"><b>[System Code] ([Region])</b></p>
      <dl outputclass="change-card">
        <dlentry>
          <dt>MFN changes</dt>
          <dd>[Affected HS chapters, or "none"]</dd>
        </dlentry>
        <dlentry>
          <dt>Preferential changes</dt>
          <dd>[Affected agreements/countries and chapter coverage, e.g., examples of FTA
            partners. — LLM-GENERATED]</dd>
        </dlentry>
      </dl>
    </section>

    <section id="new-content">
      <title>New Cross-Border Content Added</title>
      <p><b>What was added:</b> [Describe any newly added systems, jurisdictions, or content sets.
        If none, write: "No changes." — LLM-GENERATED]</p>
    </section>

    <section id="supporting-resources">
      <title>Supporting Resources</title>
      <p><b>Resources:</b> [Link to help articles, content coverage references, or supporting
        assets. — AUTHOR if applicable]</p>
      <ul>
        <li><xref href="[url]" format="html" scope="external">[Resource title]</xref></li>
      </ul>
    </section>
  </refbody>
  <related-links>
    <link href="avatax-xb-releasenotes.dita">
      <linktext>AvaTax Cross-Border Release Notes</linktext>
    </link>
  </related-links>
</reference>
